<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="src" path="src"/>
	<classpathentry excluding="gcr-codebase/|gcr-codebase/" kind="src" path="dsa-practice"/>
	<classpathentry kind="src" path="linkedlist/gcr-codebase"/>
	<classpathentry kind="src" path="dsa-practice/gcr-codebase"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="bin"/>
</classpath>
